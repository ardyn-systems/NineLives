{
  "name": "ninelives",
  "productName": "NineLives",
  "version": "1.3.0",
  "description": "Push-button hashcat console (Electron)",
  "author": "Ardyn Systems",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/captures.test.js",
    "smoke": "electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ardynsystems.ninelives",
    "productName": "NineLives",
    "executableName": "ninelives",
    "directories": {
      "output": "dist",
      "buildResources": "buildres"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../webui",
        "to": "webui"
      },
      {
        "from": "../vendor",
        "to": "vendor"
      },
      {
        "from": "../examples",
        "to": "examples"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "buildres/icon.ico",
      "artifactName": "NineLives-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "buildres/icon.ico",
      "uninstallerIcon": "buildres/icon.ico",
      "installerHeaderIcon": "buildres/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "buildres/icon.png",
      "category": "Utility",
      "artifactName": "NineLives-${version}-x86_64.${ext}"
    }
  }
}
